# Reverse-proxy HTTPS vers le gateway Supabase (Kong).
# Kong sert à la fois l'API (/rest, /auth, /storage…) et le Studio (avec auth).
# Caddy obtient/renouvelle le certificat Let's Encrypt automatiquement
# (ports 80 + 443 doivent être redirigés depuis la box vers le NAS).

{$GM_DOMAIN} {
	encode zstd gzip
	reverse_proxy kong:8000
	tls {$GM_EMAIL}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
